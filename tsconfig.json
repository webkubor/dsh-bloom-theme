{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": false,
    "sourceMap": false,
    "newLine": "lf"
  },
  // 只编译 node 半侧 —— 它必须是 ESM，由 cordis loader 按 ESM 读取。
  // 浏览器半侧走 scripts/bundle.mjs（esbuild → 单文件 IIFE），原因见该脚本注释：
  // DSH 的插件 client.js 是 classic script，容不下 import/export。
  // 全量类型检查在 tsconfig.check.json（npm run typecheck）。
  "include": ["src/index.ts", "src/globals.d.ts"]
}
